{
  "name": "@instruktlabs/holodeck",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "holodeck": "bin/holodeck.mjs"
  },
  "files": [
    "bin/",
    "server/",
    "src/",
    "skills/",
    "examples/",
    "assets/cove/",
    "public/assets/",
    "public/design/first-person/",
    "public/fonts/",
    "public/fixtures/",
    "scripts/prepare-runtime.mjs",
    "vite.config.js",
    "index.html",
    "prototype.html",
    "design.html",
    "walkthrough.html",
    "!**/*.test.mjs",
    "docs/",
    "LICENSES/",
    "LICENSING.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "predev": "npm run prepare:runtime",
    "prebuild": "npm run prepare:runtime",
    "dev": "vite --host 127.0.0.1 --port 4186 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4187 --strictPort",
    "probe:render": "node scripts/probe.mjs",
    "probe:speech": "node scripts/speech-probe.mjs",
    "test:prototype": "node --test src/prototype/session.test.mjs",
    "probe:prototype": "node scripts/prototype-probe.mjs && node scripts/prototype-crossing.mjs",
    "test:world": "node --test server/*.test.mjs",
    "test:runtime": "node --test src/world/*.test.mjs",
    "check:distribution": "node scripts/check-distribution.mjs",
    "probe:world": "node scripts/world-probe.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@instruktlabs/kiln": "1.3.1",
    "@pmndrs/glyph": "0.1.0",
    "@react-three/fiber": "9.8.2",
    "@react-three/uikit": "1.0.77",
    "math": "0.1.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "three": "0.186.1",
    "vite": "8.3.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/instruktlabs/holodeck.git"
  }
}
