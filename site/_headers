# Cloudflare Pages response headers for the scene shelf.
# Every page: no MIME sniffing, no framing, a strict referrer and no device APIs.
# There is no script Content-Security-Policy, which could break the WebGPU viewer.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Scene viewer bundles, GLBs and terrain textures are named by their content hash,
# so they never change in place.
/worlds/*/assets/*
  Cache-Control: public, max-age=31536000, immutable
