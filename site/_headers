# Cloudflare Pages response headers for the scene shelf.
# Every page: no MIME sniffing, no framing, a strict referrer and no device APIs.
# There is no script Content-Security-Policy, which could break the WebGPU viewer.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Scene viewer bundles, GLBs and terrain textures are named by their content hash,
# so they never change in place. Pages allows one splat per rule, so the scene is a placeholder.
/worlds/:world/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The project's own pages.dev hosts serve the same files (production at holodeck-5mm.pages.dev,
# each deployment and branch alias beneath it), so search engines are told not to index them;
# only https://holodeck.kilnstudio.tools/ is indexed. Pages matches an absolute rule on its host,
# where :name is one label (developers.cloudflare.com/pages/configuration/headers/).
https://holodeck-5mm.pages.dev/*
  X-Robots-Tag: noindex

https://:version.holodeck-5mm.pages.dev/*
  X-Robots-Tag: noindex
